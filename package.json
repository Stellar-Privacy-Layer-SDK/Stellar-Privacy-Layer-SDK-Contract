{
  "name": "stellar-privacy-layer",
  "version": "0.1.0",
  "private": true,
  "description": "Confidential transfers SDK on Stellar — shielded assets with selective compliance disclosure (Protocol 25 ZK primitives).",
  "license": "MIT OR Apache-2.0",
  "workspaces": [
    "packages/sdk",
    "packages/selective-disclosure",
    "packages/dapp"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "jsdom": "^30.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "scripts": {
    "build:sdk": "npm run build -w packages/sdk",
    "build:selective-disclosure": "npm run build -w packages/selective-disclosure",
    "build:dapp": "npm run build -w packages/dapp",
    "build:all": "npm run build:sdk && npm run build:selective-disclosure && npm run build:dapp",
    "test": "npm run test --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "npm run build:sdk && npm run typecheck --workspaces --if-present",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test:coverage && npm run build:all",
    "dev": "npm run dev -w packages/dapp",
    "preview": "npm run preview -w packages/dapp",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "clean": "rm -rf packages/sdk/dist packages/selective-disclosure/dist packages/dapp/dist"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "packageManager": "npm@11.9.0"
}
